<dataset name="IPD" rank="3" index="*;47;16" plot="cylindrical" >
  <!-- Four records from the TRACERS-2 ACI L1B pipeline (2026-10-14, cusp).
       Index 1 carries TWO coordinates: the energy table and a time offset
       sequence, so a CDF writer must use DEPEND_1 for one and AUX_DEPEND_1
       for the other.  The anode table is a one-component spherical vector
       (theta only); its missing radius defaults to 1, a unit direction. -->
  <properties>
    <p name="Data_type">H0&gt;High Resolution data</p>
    <p name="Time_resolution">6.5 ms</p>
    <p name="description">360 degree in-plane scans in 47 energies</p>
    <p name="label">Ion Energy-Angle Distribution</p>
  </properties>
  <coord physDim="energy" name="energy" axis="ρ">
    <properties>
      <p name="DICT_KEY">energy&gt;ion</p>
      <p name="cdfName">ts2_l1b_aci_energy</p>
      <p name="format">%.3e</p>
      <p name="label">Ion Energy</p>
      <p name="notes">This is the center point of the energy band.</p>
      <p type="real" name="scaleMax" units="eV">1.848e+04</p>
      <p type="real" name="scaleMin" units="eV">1.090e+01</p>
      <p name="scaleType">log</p>
      <p name="summary">Ion Energy Band Center</p>
      <p name="title">Ion Energy Center</p>
      <p type="real" name="validMax" units="eV">2.0e+04</p>
      <p type="real" name="validMin" units="eV">1.0</p>
    </properties>
    <scalar semantic="real" storage="double" index="-;47;-" units="eV">
      <values>
        8.393 11.554 16.078 22.89 31.12 43.328 60.277
        83.876 116.68 162.36 225.9 314.3 437.36 604.95
        846.71 1178.2 1639.3 2281 3173.8 4416 6144.5
        8549.6 11881 16514 19511 14061 10083 7248
        5209.1 3743.7 2690.6 1933.7 1389.8 998.82 717.82
        512.3 370.76 266.45 191.51 137.61 98.918 71.068
        51.067 36.733 26.596 18.966 13.625
      </values>
    </scalar>
  </coord>
  <coord physDim="direction" name="anode" axis="φ">
    <properties>
      <p name="avgType">angle_degrees</p>
      <p name="DICT_KEY">angle&gt;sector</p>
      <p name="cdfName">ts2_l1b_aci_ion_velocity_dir</p>
      <p name="format">%.1f</p>
      <p name="label">Particle Direction</p>
      <p name="notes">Frame _REDUCED just means the azimuth angle is zero</p>
      <p type="real" name="scaleMax" units="degrees">275</p>
      <p type="real" name="scaleMin" units="degrees">-95</p>
      <p name="scaleType">linear</p>
      <p name="summary">Ion anode polar angle from TS2 +Z axis</p>
      <p name="title">Ion Velocity Direction</p>
      <p type="real" name="validMax" units="degrees">270</p>
      <p type="real" name="validMin" units="degrees">-90</p>
    </properties>
    <composite semantic="real" storage="double" intern="1" index="-;-;16" units="degrees">
      <properties>
        <p type="stringArray" name="label" term=";">θ</p>
        <p name="frameInfo">ACI-Azimuthal instrument frame, directions correspond with rough velocity vector of electrons</p>
      </properties>
      <ops kind="vector" frame="TS2_ACI_REDUCED" system="spherical" sysorder="1"/>
      <values>
        -90 -67.5 -45 -22.5 0 22.5 45
        67.5 90 112.5 135 157.5 180 202.5
        225 247.5
      </values>
    </composite>
  </coord>
  <coord physDim="time" name="time" axis="z">
    <properties>
      <p type="real" name="BIN_LOCATION">0.02174</p>
      <p name="DICT_KEY">time&gt;Epoch</p>
      <p name="MONOTON">INCREASE</p>
      <p name="cdfName">Epoch</p>
      <p name="label">UTC</p>
      <p name="summary">Timestamp of 2nd energy sweep, 6.5 ms after 1st</p>
      <p name="title">Sweep start in UTC</p>
      <p type="datetime" name="validMax">2050-01-01</p>
      <p type="datetime" name="validMin">2022-02-01</p>
    </properties>
    <scalar use="offset" semantic="integer" storage="long" index="-;47;-" units="ns">
      <properties>
        <p name="cdfName">EpochOffset</p>
        <p name="label">Offset time</p>
        <p name="summary">Sample offset from packet timestamp</p>
        <p name="title">Sample offset from Epoch</p>
      </properties>
      <sequence minval="-9417000" interval="-;6500000;-" />
    </scalar>
    <scalar use="reference" semantic="datetime" storage="struct" index="*;-;-" units="UTC">
      <ops kind="point"/>
      <packet numItems="1" itemBytes="27" encoding="utf8" fill="0001-01-01T00:00:00.000000" />
    </scalar>
  </coord>
  <coord physDim="location" name="location" annotation="z">
    <properties>
      <p name="label">TS2,IAU_EARTH</p>
      <p name="title">TS2 in spherical IAU_EARTH</p>
      <p name="summary">Body-fixed EARTH centered location of TS2 in spherical coordinates</p>
      <p name="notes">An ISO 31-11 standard spherical system. The full component set is (r,θ,φ) where r is the radial direction, θ is the colatitude (which is 0° at the north pole) and φ is the eastward angle. Both θ, φ are assumed to be 0° if missing and r is assumed to be 1 if missing.</p>
      <p name="format">%.4e</p>
    </properties>
    <composite semantic="real" storage="float" intern="3" index="*;-;-" units="km">
      <properties>
        <p type="stringArray" name="label" term=";">r;θ;φ</p>
      </properties>
      <ops kind="position" body="EARTH" frame="IAU_EARTH" fixed="true" system="spherical"/>
      <packet numItems="3" itemBytes="13" encoding="utf8" fill="-1.000000e+31" />
    </composite>
  </coord>
  <data physDim="flux" name="flux">
    <properties>
      <p name="DICT_KEY">particle_flux&gt;differential</p>
      <p name="DISPLAY_TYPE">spectrogram</p>
      <p name="cdfName">ts2_l1b_aci_flux</p>
      <p name="format">%.2e</p>
      <p name="label">Ion Diff En Flux</p>
      <p type="real" name="scaleMax">4000</p>
      <p type="real" name="scaleMin">0.1</p>
      <p name="scaleType">log</p>
      <p name="summary">Ion Differential Energy Flux from 360 degree anode-plane scans in 47 energy bins</p>
      <p name="title">Ion Differential Energy Flux</p>
      <p type="real" name="validMax" units="cm**-2 s**-1 sr**-1">1.493e+08</p>
      <p type="real" name="validMin" units="cm**-2 s**-1 sr**-1">0.0</p>
      <p name="calDataSource">TRACERS-SOT email with Stephen Fuselier</p>
      <p type="datetime" name="calDate">2025-12-03</p>
    </properties>
    <scalar semantic="real" storage="float" index="*;47;16" units="cm**-2 s**-1 sr**-1">
      <packet numItems="752" itemBytes="13" encoding="utf8" fill="nan" />
    </scalar>
  </data>
</dataset>
